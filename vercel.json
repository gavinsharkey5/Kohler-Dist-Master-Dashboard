{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "codex/photos-merchandising-timeout-pdf": false
    }
  },
  "buildCommand": null,
  "installCommand": null,
  "trailingSlash": true,
  "functions": {
    "api/field-accounts.js": { "includeFiles": "territory-accounts/customers_active.csv" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(json|csv|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
